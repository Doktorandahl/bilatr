# Reference source this package was built from; not part of the package.
original_code/

# Compiled Stan model binaries and build artifacts: keep only the .stan
# sources under inst/stan/, exclude everything else (extensionless
# executables, *.o, *.hpp, *.d, etc.), regardless of which model it's for.
#
# NOTE (0.8.1; narrowed 0.10.0): .Rbuildignore's matching rule,
# `^inst/stan/(?!include$)[^/.]+$`, excludes every extensionless entry
# directly under inst/stan/ from the built tarball EXCEPT `include` (a new
# subdirectory added here, other than `legacy` -- see below -- must be
# added to that lookahead too, or R CMD build will silently drop it).
# `tests/testthat/test_stan_includes.R` already resolves `include/` via
# `system.file()`, so an excluded `include/` would fail `R CMD check` on
# its own; that's why no extra guard test exists for this rule.
inst/stan/*
!inst/stan/*.stan
!inst/stan/include/
inst/stan/include/*
!inst/stan/include/*.stanfunctions

# Retired model sources kept for local reference only, not part of the
# package (the `inst/stan/*` rule above already covers this). Every
# retired model lives here, gitignored -- including, since 0.10.0,
# stable_soft_anchor/ou_soft_anchor (the pre-0.4.2 soft-sign-anchor
# programs, previously the sole exception here so pre-0.4.2 CmdStan
# output stayed readable; fully retired now, see NEWS.md). `.Rbuildignore`
# excludes the whole directory (`^inst/stan/legacy$`) from any build
# regardless of what's git-tracked here.
!inst/stan/legacy/
inst/stan/legacy/*

# Local analysis/run scripts, not part of the package.
runscripts/

# Local audit notes / scratch, not part of the package.
dev/

# Local machine/tooling artifacts, not part of the package.
.DS_Store
.claude/
Claude outputs/
logs/
