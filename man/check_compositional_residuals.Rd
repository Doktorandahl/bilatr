r_rep^s  = clr(yrep_d^s + eps) - clr(pbar_d^s)      # yrep_dt^s ~ DirMult(phi_d^s * p_dt^s) at the OBSERVED n_dt
along^s  = <r, alpha_c> / <alpha_c, alpha_c>        # theta-absorbable misfit
perp^s   = r - along^s * alpha_c                    # beta-absorbable misfit
}\if{html}{\out{</div>}}

